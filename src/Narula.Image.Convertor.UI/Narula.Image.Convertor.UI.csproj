<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>img2imgUI</AssemblyName>
    <RootNamespace>Narula.Image.Convertor.UI</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\Narula.Image.Convertor\icon.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Publish defaults: framework-dependent and single file, so a publish drops one
         executable rather than a folder of hundreds. Add -p:SelfContained=true only for a
         machine with no .NET runtime. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Batch image format conversion.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Narula.Image.Convertor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Narula.Image.Convertor\Narula.Image.Convertor.csproj" />
  </ItemGroup>

  <!--
    Skia and HarfBuzz ship native .pdb symbols totalling around 105MB, four times the
    application itself. They come from runtime package assets rather than reference-related
    files, so they have to be dropped from the publish set explicitly.
  -->
  <Target Name="DropNativeSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
