<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Narula.Image.Convertor.UI"
        x:Class="Narula.Image.Convertor.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Image to Image Convertor"
        Width="760" Height="900"
        MinWidth="660" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Light"
        Background="#FBFCFE">

  <!--
    The palette is the application icon's: indigo, violet and amber, at pastel strength so the
    cards read as sections rather than decoration. The window is pinned to the light variant
    because these tints are chosen against a light ground and would be wrong inverted.
  -->
  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#6B6B86" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#77778F" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="13" />
      <Setter Property="Margin" Value="0,0,0,9" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4F46E5" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4338CA" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#D9D8EC" />
      <Setter Property="Foreground" Value="#8E8DA8" />
    </Style>
    <!--
      The drop-down chevron. Two things here are load-bearing rather than cosmetic.
      VerticalContentAlignment must be Center: content alignment defaults to Stretch, which
      stretches the glyph's own text block and leaves the glyph drawn at its top edge.
      Focusable must be false: AutoCompleteBox closes its drop-down on lost focus, so a
      focusable button inside the box would shut the list in the same click that opened it.
    -->
    <Style Selector="Button.chevron">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Content" Value="&#xE70D;" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="#5B5B78" />
    </Style>
    <Style Selector="Button.chevron /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chevron:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#3B3B58" />
    </Style>
    <Style Selector="Button.chevron:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#4F46E5" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#6B6B86" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#ECECF6" />
      <Setter Property="Foreground" Value="#3B3B58" />
    </Style>
  </Window.Styles>

  <ScrollViewer Padding="18">
    <StackPanel>

      <!-- About sits outside the setup panel so it stays reachable while a conversion runs. -->
      <Button x:Name="AboutButton" Content="About" Classes="quiet"
              HorizontalAlignment="Right" Margin="0,0,2,4" />

      <StackPanel x:Name="SetupPanel" IsEnabled="{Binding IsIdle}">

      <!-- Source. Dropping a folder is the point: it is what a browser UI could never do. -->
      <Border Classes="card" Background="#EFF3FF" BorderBrush="#D7E0FB">
        <StackPanel>
          <TextBlock Classes="label" Text="SOURCE" />
          <Border x:Name="DropZone" Background="#FFFFFF"
                  BorderThickness="1" BorderBrush="#C7D4F7"
                  CornerRadius="8" Padding="13" Margin="0,0,0,8">
            <TextBlock x:Name="SourceText" Text="Drop a folder or image here" TextWrapping="Wrap" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Button x:Name="BrowseFolder" Content="Choose folder..." />
            <Button x:Name="BrowseFile" Content="Choose file..." />
            <CheckBox Content="Include subfolders" IsChecked="{Binding Recursive}" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Classes="label" Text="ONLY THESE FILES" Margin="0,2,0,6" />
          <AutoCompleteBox x:Name="FilterBox" Width="260"
                           HorizontalAlignment="Left"
                           ItemsSource="{Binding SourceFilters}"
                           Text="{Binding SourceFilter}"
                           FilterMode="Contains"
                           MinimumPrefixLength="0"
                           IsTextCompletionEnabled="False">
            <AutoCompleteBox.InnerRightContent>
              <Button x:Name="FilterDropDown" Classes="chevron" />
            </AutoCompleteBox.InnerRightContent>
          </AutoCompleteBox>
        </StackPanel>
      </Border>

      <!--
        Convert to. Typing filters the list, which matters at nearly two hundred formats.
        IsTextCompletionEnabled is off deliberately on both of these boxes: AutoCompleteBox
        refuses to populate its list while text is selected and completion is on, and focusing
        a box selects all of its text, so with completion on the chevron could never open
        anything. Inline completion is not worth losing the drop-down over.
      -->
      <Border Classes="card" Background="#F6F0FF" BorderBrush="#E2D5FB">
        <StackPanel>
          <TextBlock Classes="label" Text="CONVERT TO" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <AutoCompleteBox x:Name="TargetBox" Width="185"
                             ItemsSource="{Binding Targets}"
                             Text="{Binding Target}"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             IsTextCompletionEnabled="False"
                             PlaceholderText="type to filter">
              <AutoCompleteBox.InnerRightContent>
                <Button x:Name="TargetDropDown" Classes="chevron" />
              </AutoCompleteBox.InnerRightContent>
            </AutoCompleteBox>
            <StackPanel Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding QualityApplies}" VerticalAlignment="Center">
              <TextBlock Text="Quality" VerticalAlignment="Center" />
              <Slider Width="180" Minimum="1" Maximum="100" Value="{Binding Quality}"
                      TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Quality}" Width="30" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <TextBlock Classes="hint" Text="{Binding TargetDescription}" Margin="2,8,0,0" />

          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                      IsVisible="{Binding IconSizeApplies}">
            <TextBlock Text="Icon size" VerticalAlignment="Center" />
            <ComboBox x:Name="IconSizeBox" Width="120" ItemsSource="{Binding IconSizes}"
                      SelectedItem="{Binding IconSize}" PlaceholderText="All sizes" />
            <Button x:Name="ClearIconSize" Content="All sizes" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#EDF9F2" BorderBrush="#CEEBDC">
        <StackPanel>
          <TextBlock Classes="label" Text="DESTINATION" />
          <TextBlock Text="{Binding DestinationHint}" TextWrapping="Wrap" />
          <TextBlock Classes="hint" Text="{Binding DestinationNote}" Margin="0,3,0,10" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="BrowseDestination" Content="Choose folder..." />
            <Button x:Name="ClearDestination" Content="Use default" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" Background="#FFF8EC" BorderBrush="#F5E3C4">
        <StackPanel Spacing="7">
          <TextBlock Classes="label" Text="OPTIONS" />
          <CheckBox Content="When applicable, retain transparency" IsChecked="{Binding PreserveTransparency}" />
          <CheckBox Content="Keep EXIF and colour profiles" IsChecked="{Binding PreserveMetadata}" />
          <CheckBox Content="Overwrite files already in the destination" IsChecked="{Binding Overwrite}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Background when flattening" VerticalAlignment="Center" />
            <TextBox Width="120" Text="{Binding Background}" />
          </StackPanel>
          <TextBlock Classes="hint"
                     Text="Transparency is flattened onto that colour when the chosen format cannot hold it, such as JPEG." />
        </StackPanel>
      </Border>

      </StackPanel>

      <Grid ColumnDefinitions="*,10,150">
        <Button Grid.Column="0" x:Name="ConvertButton" Classes="primary" Content="Convert"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="0,11" IsEnabled="{Binding CanConvert}" />
        <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="0,11" CornerRadius="8" FontSize="15"
                IsEnabled="{Binding CanCancel}" />
      </Grid>

      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                   Margin="0,14,0,8" Foreground="#7C3AED" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,6,0,0"
                 FontWeight="SemiBold" Foreground="#3F3D63" />

      <ItemsControl ItemsSource="{Binding Failures}" Margin="0,10,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                       Foreground="#B23B3B" Margin="0,0,0,3" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</Window>
