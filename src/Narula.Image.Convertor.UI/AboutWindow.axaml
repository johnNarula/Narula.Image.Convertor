<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Narula.Image.Convertor.UI"
        x:Class="Narula.Image.Convertor.UI.AboutWindow"
        Title="About Image to Image Convertor"
        Width="560" Height="720"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Light"
        Background="#FBFCFE">

  <Window.Styles>
    <Style Selector="TextBlock.rowlabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#77778F" />
      <Setter Property="Width" Value="118" />
    </Style>
    <Style Selector="TextBlock.rowvalue">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="#33334D" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="20">

    <Border Grid.Row="0" Classes="card" Background="#EFF3FF" BorderBrush="#D7E0FB"
            BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
      <StackPanel Spacing="4">
        <TextBlock x:Name="ProductText" FontSize="17" FontWeight="SemiBold" Foreground="#2B2B45" />
        <TextBlock x:Name="VersionText" FontSize="12" Foreground="#5B5B78" />
        <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="#5B5B78"
                   TextWrapping="Wrap" Margin="0,6,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="9">
        <ItemsControl x:Name="Rows">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AboutRow">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                <TextBlock Classes="rowlabel" Text="{Binding Label}" />
                <TextBlock Classes="rowvalue" Text="{Binding Value}" Width="330" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
          The agent section. Two ways in, because Claude Code takes one command and everything
          else wants the JSON, and neither audience should have to read the other's route.
        -->
        <Border x:Name="McpCard" Background="#F6F0FF" BorderBrush="#E2D5FB" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,4,0,8">
          <StackPanel Spacing="5">
            <TextBlock x:Name="McpHeading" FontSize="11" FontWeight="SemiBold" Foreground="#6B6B86" />
            <TextBlock x:Name="McpSummary" FontSize="11.5" Foreground="#4A4A66" TextWrapping="Wrap" />

            <TextBlock Text="Claude Code, in one command:" FontSize="11" Foreground="#77778F" Margin="0,4,0,0" />
            <SelectableTextBlock x:Name="McpCommand" FontFamily="Consolas, Menlo, monospace"
                                 FontSize="11" Foreground="#33334D" TextWrapping="Wrap" />

            <TextBlock x:Name="McpOther" FontSize="11" Foreground="#77778F"
                       TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock x:Name="McpTools" FontSize="11" Foreground="#8B8BA3" TextWrapping="Wrap" />

            <Button x:Name="McpCopyButton" Content="Copy config" Padding="10,4" FontSize="11.5"
                    HorizontalAlignment="Left" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Laid out by hand rather than as another row, because the value is a link. -->
        <StackPanel Orientation="Horizontal" Margin="0,-4,0,4">
          <TextBlock Classes="rowlabel" Text="Author" VerticalAlignment="Center" />
          <HyperlinkButton x:Name="AuthorLink" Padding="0" FontSize="11.5"
                           VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="CopyrightText" FontSize="11.5" Foreground="#77778F" />
        <TextBlock FontSize="11" Foreground="#8B8BA3" TextWrapping="Wrap"
                   Text="Imaging by Magick.NET and ImageMagick (Apache-2.0). Window by Avalonia (MIT)." />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,14,0,0">
      <Button x:Name="CopyButton" Content="Copy details" Padding="14,7" />
      <Button x:Name="CloseButton" Content="Close" Padding="20,7"
              Background="#4F46E5" Foreground="White" CornerRadius="6" />
    </StackPanel>

  </Grid>
</Window>
