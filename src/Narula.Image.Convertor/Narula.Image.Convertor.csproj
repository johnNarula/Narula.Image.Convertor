<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>nImgConvertor</AssemblyName>
    <RootNamespace>Narula.Image.Convertor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Measured: R2R changed startup by 1ms here (single-file extraction dominates) and cost 12MB. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Magick.NET carries native libraries: trimming is unsafe and they must be bundled. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Product>nImgConvertor</Product>
    <Description>Batch image format conversion from the command line.</Description>
    <Authors>John Narula</Authors>
    <Company>Narula</Company>
    <Copyright>Copyright © John Narula</Copyright>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Narula.Image.Convertor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
  </ItemGroup>

</Project>
