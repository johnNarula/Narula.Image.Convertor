<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Narula.Image.Convertor</AssemblyName>
    <RootNamespace>Narula.Image.Convertor</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Measured: R2R changed startup by 1ms here (single-file extraction dominates) and cost 12MB. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Magick.NET carries native libraries: trimming is unsafe and they must be bundled. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup>
    <Description>Batch image format conversion from the command line.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Narula.Image.Convertor.Tests" />
    <InternalsVisibleTo Include="img2img" />
    <InternalsVisibleTo Include="img2imgUI" />
    <InternalsVisibleTo Include="img2imgMcp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
  </ItemGroup>

</Project>
