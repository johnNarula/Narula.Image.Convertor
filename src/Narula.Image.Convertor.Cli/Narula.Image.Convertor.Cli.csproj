<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>img2img</AssemblyName>
    <RootNamespace>Narula.Image.Convertor.Cli</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationIcon>..\Narula.Image.Convertor\icon.ico</ApplicationIcon>
    <!-- Magick.NET carries native libraries: trimming is unsafe and they must be bundled. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Measured: R2R changed startup by 1ms here (single-file extraction dominates) and cost 12MB. -->
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Image to Image Convertor</Product>
    <Description>Batch image format conversion from the command line.</Description>
    <Authors>John Narula</Authors>
    <Company>9thAct LLC</Company>
    <Copyright>2026 Copyright © 9th Act, LLC</Copyright>
    <Title>Image to Image Convertor</Title>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Narula.Image.Convertor\Narula.Image.Convertor.csproj" />
  </ItemGroup>

</Project>
